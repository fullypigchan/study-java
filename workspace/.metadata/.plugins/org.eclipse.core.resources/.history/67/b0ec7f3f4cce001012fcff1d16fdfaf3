package inputTest;

import java.util.Scanner;

public class InputTest05 {

	public static void main(String[] args) {
//		두 정수를 입력받은 뒤 곱셈의 결과가 30보다 큰지 검사한다.
//		1. 30보다 클 때: "30보다 큽니다" 출력
//		2. 30보다 작을 때: "30보다 작습니다" 출력
//		3.30과 같을 때는 없다고 가정한다.
		String question="두 정수를 입력해주세요.";
		int num01=0;
		int num02=0;
		String message1="30보다 큽니다.";
		String message2="30보다 작습니다.";
		String errorMessage="다시 입력해주세요";
		int number=num01*num02;
		String result=null;
		Scanner sc=new Scanner(System.in);
		
		System.out.println(question);
		num01=sc.nextInt();
		num02=sc.nextInt();
		boolean numCondition1= false;
		boolean numCondition2=false;
		
		numCondition1=number>30;
		numCondition2=number<30;
		
		result = numCondition1?message1:numCondition2?message2
				:errorMessage;
		
		System.out.println(result);
		
		sc.close();
		
	}

}
