	public List<OrderVO> findOrdersByDateRange(String startDate, String endDate) {
		StringBuilder stringBuilder = new StringBuilder();
		String query = null;
		OrderVO order = null;
		List<OrderVO> orders = new ArrayList<>();

		stringBuilder.append("select id, customer_name, customer_email, total_amount, order_status, created, updated ");
		stringBuilder.append("from tbl_order ");
		stringBuilder.append("where date(created) between ? and ? ");
		stringBuilder.append("order by created desc ");

		query = stringBuilder.toString();

		connection = DBConnecter.getConnection();

		try {
			preparedStatement = connection.prepareStatement(query);
			preparedStatement.setString(1, startDate); // '2024-12-01'
			preparedStatement.setString(2, endDate); // '2024-12-31'
			resultSet = preparedStatement.executeQuery();

			while (resultSet.next()) {
				order = new OrderVO();
				order.setId(resultSet.getLong("id"));
