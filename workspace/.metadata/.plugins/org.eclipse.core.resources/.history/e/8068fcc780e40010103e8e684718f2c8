	// 13. 특정 주문의 전체 정보 조회 (JOIN 3개 테이블)
	public List<OrderDetailVO> findOrderDetailsById(Long orderId) {
		StringBuilder stringBuilder = new StringBuilder();
		String query = null;
		OrderDetailVO detail = null;
		List<OrderDetailVO> details = new ArrayList<>();

		stringBuilder.append(
				"select o.id AS order_id, o.customer_name, o.customer_email, o.total_amount, o.order_status, o.created AS order_created, ");
		stringBuilder.append("oi.id AS order_item_id, oi.quantity, oi.price AS item_price, ");
		stringBuilder.append("p.id AS product_id, p.product_name, p.category ");
		stringBuilder.append("from tbl_order o "); // ✅ 메인 테이블을 먼저 쓰는 게 일반적
		stringBuilder.append("inner join tbl_order_item oi on o.id = oi.order_id ");
		stringBuilder.append("inner join tbl_product p on oi.product_id = p.id ");
		stringBuilder.append("where o.id = ? ");

		query = stringBuilder.toString();

		connection = DBConnecter.getConnection();

		try {
			preparedStatement = connection.prepareStatement(query);
			preparedStatement.setLong(1, orderId);
			resultSet = preparedStatement.executeQuery();

			while (resultSet.next()) {
				detail = new OrderDetailVO();

				// Order 정보
				detail.setOrderId(resultSet.getLong("order_id"));
				detail.setCustomerName(resultSet.getString("customer_name"));
				detail.setCustomerEmail(resultSet.getString("customer_email"));
				detail.setTotalAmount(resultSet.getInt("total_amount"));
				detail.setOrderStatus(resultSet.getString("order_status"));
				detail.setOrderCreated(resultSet.getString("order_created"));

				// OrderItem 정보
				detail.setOrderItemId(resultSet.getLong("order_item_id"));
				detail.setQuantity(resultSet.getInt("quantity"));
				detail.setItemPrice(resultSet.getInt("item_price"));

				// Product 정보
				detail.setProductId(resultSet.getLong("product_id"));
				detail.setProductName(resultSet.getString("product_name"));
				detail.setCategory(resultSet.getString("category"));

				details.add(detail);
			}

		} catch (SQLException e) {
			e.printStackTrace();
			System.out.println("findOrderDetailsById(Long) SQL문 오류");
		} finally {
			try {
				if (resultSet != null) {
					resultSet.close();
				}
				if (preparedStatement != null) {
					preparedStatement.close();
				}
				if (connection != null) {
					connection.close();
				}
			} catch (SQLException e) {
				e.printStackTrace();
				throw new RuntimeException(e);
			}
		}

		return details;
	}

