//17. 가장 많이 팔린 상품 TOP N (GROUP BY, ORDER BY, LIMIT)
	public List<Map<String, Object>> findTopSellingProducts(int limit) {
		StringBuilder stringBuilder = new StringBuilder();
		String query = null;
		List<Map<String, Object>> results = new ArrayList<>();
		
		stringBuilder.append(
				"select p.id, p.product_name,sum(oi.quantity) as total_quantity,sum(oi.quantity * oi.price) as total_sales ");
		stringBuilder.append("from tbl_order_item oi join tbl_product p ");
		stringBuilder.append("on oi.product_id = p.id join tbl_order o ");
		stringBuilder.append("on oi.order_id = o.id ");
		stringBuilder.append("where o.order_status != '취소됨' ");
		stringBuilder.append("group by p.id, p.product_name ");
		stringBuilder.append("order by total_quantity desc ");
		stringBuilder.append("limit ? ");
		
		query = stringBuilder.toString();
		
		connection = DBConnecter.getConnection();
		
		try {
			preparedStatement = connection.prepareStatement(query);
			preparedStatement.setInt(1, limit);
			resultSet = preparedStatement.executeQuery();
			
			while(resultSet.next()) {
				Map<String, Object> result = new HashMap<>();
	            result.put("product_id", resultSet.getLong("product_id"));
	            result.put("product_name", resultSet.getString("product_name"));
	            result.put("total_quantity", resultSet.getInt("total_quantity"));
	            result.put("total_sales", resultSet.getLong("total_sales"));
	            
	            results.add(result);	
			}
		} catch (SQLException e) {
			e.printStackTrace();
		}
		
	}
